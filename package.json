{
  "name": "playwright-boilerplate",
  "version": "1.2.0",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:ui:slow": "playwright test --ui --workers 3",
    "test:ui:headed": "playwright test --ui --headed",
    "test:ui:record": "cross-env PLAYWRIGHT_RECORD=true playwright test --ui",
    "test:ui:record:headed": "cross-env PLAYWRIGHT_RECORD=true playwright test --ui --headed",
    "codegen": "playwright codegen --output src/tests/codegen.ts http://localhost:5173",
    "lint": "cross-env TIMING=1 npx eslint",
    "lint:fix": "npm run lint -- --fix",
    "lint:debug": "npm run lint -- --debug",
    "format:md": "npx prettier --write \"**/*.md\"",
    "typecheck": "npx tsc --noEmit",
    "format": "npx prettier . --write",
    "bump-version": "npx tsx ./scripts/bump-version.script.ts && npm audit fix",
    "parse-llm-response": "npx tsx ./scripts/split-plain-code.ts",
    "postinstall": "npx playwright install"
  },
  "keywords": [
    "typescript",
    "boilerplate",
    "eslint",
    "prettier",
    "modern",
    "vitest",
    "template"
  ],
  "author": "Dmytro Vakulenko",
  "license": "ISC",
  "description": "Modern, scalable TypeScript boilerplate for Node.js projects with strict linting, Prettier formatting, modular structure, and Vitest testing.",
  "dependencies": {
    "@playwright/test": "^1.57.0",
    "typed-dotenv": "^10.0.2"
  },
  "devDependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "^7.1.10",
    "@dword-design/eslint-plugin-import-alias": "^8.1.3",
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^22.18.8",
    "@vitest/eslint-plugin": "^1.6.5",
    "cross-env": "^10.1.0",
    "deepmerge": "^4.3.1",
    "eslint": "^9.39.2",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-naming": "^1.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-no-barrel-files": "^1.2.2",
    "eslint-plugin-no-secrets": "^2.2.1",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-playwright": "^2.4.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-project-structure": "^3.14.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.0.0",
    "json5": "^2.2.3",
    "prettier": "^3.7.4",
    "type-fest": "^5.3.1",
    "typescript-eslint": "^8.52.0",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "eslint-config-airbnb-base": {
      "eslint": "^9"
    }
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git@github-personal:DrSmile444/typescript-boilerplate.git"
  }
}
